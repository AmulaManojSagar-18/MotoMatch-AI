# MotoMatch backend configuration (Phase 1)
#
# Copy this file to `.env` and adjust values for your environment.
# PostgreSQL is the source of truth for the bike catalog.
#
# Full SQLAlchemy database URL. Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#
# The default below assumes a local PostgreSQL on port 5432 with a database
# named "motomatch". Create the database first, e.g.:
#   createdb motomatch
# or in psql:
#   CREATE DATABASE motomatch;
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/motomatch

# --- AI provider (Phase 2) ---
# Which provider powers natural-language understanding. Only "ollama" is
# implemented today; the app is decoupled via the AIProvider interface.
AI_PROVIDER=ollama

# Local Ollama server + model. Start the server with `ollama serve` and make
# sure the model is pulled (e.g. `ollama pull qwen2.5:7b`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

# Embedding model for the RAG bike-knowledge feature (Phase 3).
# Pull it with: ollama pull nomic-embed-text
# If it is not available, the retriever falls back to keyword matching.
OLLAMA_EMBED_MODEL=nomic-embed-text
